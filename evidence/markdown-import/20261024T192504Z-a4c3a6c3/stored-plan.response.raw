{"summary":{"project_id":"dummy-markdown-chain-4","description":"Describe a synthetic data quality handoff. Simulation records scheduling receipts but does not create or validate a real data product.","task_count":5,"total_estimate_minutes":13.0,"critical_path_estimate_minutes":11.0,"estimate_note":"Authored estimates only; excludes review, retries and overhead. Not a forecast.","tasks":[{"task_id":"collect","title":"Specify sample records","description":"Identify the synthetic fields and record count.","estimate_minutes":2.0,"depends_on":[],"dependency_layer":1,"executor":"simulation","acceptance_criteria":["Fields and record count are stated."]},{"task_id":"validate","title":"Specify validation rules","description":"Write checks for required and numeric fields.","estimate_minutes":4.0,"depends_on":["collect"],"dependency_layer":2,"executor":"simulation","acceptance_criteria":["Required-field and numeric bounds are explicit."]},{"task_id":"report","title":"Specify quality report","description":"Define a quality summary using the validation rules.","estimate_minutes":3.0,"depends_on":["validate"],"dependency_layer":3,"executor":"simulation","acceptance_criteria":["Every rule has a reported count."]},{"task_id":"alert","title":"Specify alert thresholds","description":"Define thresholds for the same validation rules.","estimate_minutes":2.0,"depends_on":["validate"],"dependency_layer":3,"executor":"simulation","acceptance_criteria":["Every alert threshold names a validation rule."]},{"task_id":"handoff","title":"Review data handoff","description":"Combine the quality report and alert thresholds in a handoff checklist.","estimate_minutes":2.0,"depends_on":["report","alert"],"dependency_layer":4,"executor":"simulation","acceptance_criteria":["The checklist references both preceding specifications."]}]},"revision":1,"plan_sha256":"0eaf99608cce0000ef4bb41a716feba5b69dd96172d3514f79b9d03552806ca8","source":{"source_sha256":"ed747d906481bde9008ab7892a9d72c8808b6111d48db0f8e
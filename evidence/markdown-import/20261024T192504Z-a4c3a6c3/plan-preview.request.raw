{"plan":{"schema_version":"1.0","project_id":"dummy-markdown-chain-4","display_name":"Sequential and branching sample","revision":1,"goal":"Describe a synthetic data quality handoff. Simulation records scheduling receipts but does not create or validate a real data product.","repository":{"path":"./runtime/examples/dummy-markdown-chain-4","base_branch":"main"},"policy":{"max_workers":2,"min_workers":0,"target_workers":2,"reserved_slots":0,"merge":"manual","full_regression":"manual"},"tasks":[{"task_id":"collect","title":"Specify sample records","description":"Identify the synthetic fields and record count.","acceptance_criteria":["Fields and record count are stated."],"estimate_minutes":2.0,"depends_on":[],"priority":50,"executor":"simulation","model":{"preference":"default"},"resources":{"slots":1},"risk_class":"low","allowed_operations":[],"validation_profile":"simulation-receipt","artifact_outputs":[],"timeout_policy":{"execution_seconds":300,"max_retries":0,"warning_multiplier":2,"escalation_multiplier":4},"escalation_conditions":["Human review if acceptance is unverified or retry budget is exhausted"]},{"task_id":"validate","title":"Specify validation rules","description":"Write checks for required and numeric fields.","acceptance_criteria":["Required-field and numeric bounds are explicit."],"estimate_minutes":4.0,"depends_on":["collect"],"priority":50,"executor":"simulation","model":{"preference":"default"},"resources":{"slots":1},"risk_class":"low","allowed_operations":[],"validation_profile":"simulation-receipt","artifact_outputs":[],"timeout_policy":{"execution_seconds":300,"max_retries":0,"warning_multiplier":2,"escalation_multiplier":4},"escalation_conditions":["Human review if acceptance is unverified or retry budget is exhausted"]},{"task_id":"report","title":"Specify quality report","description":"Define a quality summary using the validation rules.","acceptance_criteria":["Every rule has a reported count."],"estimate_minutes":3.0,"depends_on":["valida
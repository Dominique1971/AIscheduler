"],"estimate_minutes":2.0,"depends_on":["validate"],"priority":50,"executor":"simulation","model":{"preference":"default"},"resources":{"slots":1},"risk_class":"low","allowed_operations":[],"validation_profile":"simulation-receipt","artifact_outputs":[],"timeout_policy":{"execution_seconds":300,"max_retries":0,"warning_multiplier":2,"escalation_multiplier":4},"escalation_conditions":["Human review if acceptance is unverified or retry budget is exhausted"]},{"task_id":"handoff","title":"Review data handoff","description":"Combine the quality report and alert thresholds in a handoff checklist.","acceptance_criteria":["The checklist references both preceding specifications."],"estimate_minutes":2.0,"depends_on":["report","alert"],"priority":50,"executor":"simulation","model":{"preference":"default"},"resources":{"slots":1},"risk_class":"low","allowed_operations":[],"validation_profile":"simulation-receipt","artifact_outputs":[],"timeout_policy":{"execution_seconds":300,"max_retries":0,"warning_multiplier":2,"escalation_multiplier":4},"escalation_conditions":["Human review if acceptance is unverified or retry budget is exhausted"]}]},"status":"draft_only; explicit preview and import required","intake":{"intake_version":"1.0","project_id":"dummy-markdown-chain-4","display_name":"Sequential and branching sample","description":"Describe a synthetic data quality handoff. Simulation records scheduling receipts but does not create or validate a real data product.","repository":{"path":"./runtime/examples/dummy-markdown-chain-4","base_branch":"main"},"policy":{"max_workers":2},"tasks":[{"task_id":"collect","title":"Specify sample records","description":"Identify the synthetic fields and record count.","estimate_minutes":2.0,"depends_on":[],"acceptance_criteria":["Fields and record count are stated."]},{"task_id":"validate","title":"Specify validation rules","description":"Write checks for required and numeric fields.","estimate_minutes":4.0,"depends_on":["collect"],"acceptance_criteria":["Required-field and numeric bounds are explicit."]},{"task_id":"report","title":"Specify quality report","description":"Define a quality summary using the validation rules.","estimate_minutes":3.0,"depends_on":["validate"],"acceptance_criteria":["Every rule has a reported count."]},{"task_id":"alert","title":"Specify alert thresholds","description":"Define thresholds for the same validation rules.","estimate_minutes":2.0,"depends_on":["validate"],"acceptance_criteria":["Every alert threshold names a validation rule."]},{"task_id":"handoff","title":"Review data handoff","description":"Combine the quality report and alert thresholds in a handoff checklist.","estimate_minutes":2.0,"depends_on":["report","alert"],"acceptance_criteria":["The checklist references both preceding specifications."]}]},"source_text":"# Scheduler project intake v1\n\nProject ID: dummy-markdown-chain-4\nProject name: Sequential and branching sample\nRepository path: ./runtime/examples/dummy-markdown-chain-4\nBase branch: main\nMaximum workers: 2\n\n## Description\nDescribe a synthetic data quality handoff. Simulation records scheduling receipts but does not create or validate a real data product.\n\n## Tasks\n\n### collect: Specify sample records\nDescription: Identify the synthetic fields and record count.\nEstimate minutes: 2\nDepends on: none\nAcceptance criteria:\n- Fields and record count are stated.\n\n### validate: Specify validation rules\nDescription: Write checks for required and numeric fields.\nEstimate minutes: 4\nDepends on: collect\nAcceptance criteria:\n- Required-field and numeric bounds are explicit.\n\n### report: Specify quality report\nDescription: Define a quality summary using the validation rules.\nEstimate minutes: 3\nDepends on: validate\nAcceptance criteria:\n- Every rule has a reported count.\n\n### alert: Specify alert thresholds\nDescription: Define thresholds for the same validation rules.\nEstimate minutes: 2\nDepends on: validate\nAcceptance criteria:\n- Every alert threshold names a validation rule.\n\n### handoff: Review data handoff\nDescription: Combine the quality report and alert thresholds in a handoff checklist.\nEstimate minutes: 2\nDepends on: report, alert\nAcceptance criteria:\n- The checklist references both preceding specifications.\n","filename":"intake-template.md","request_sha256":"027111278abca234b828130b68ab7912c7d9c04cb6a92403ff5bc0b3b45b4712"}
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scheduler-dashboard",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": "public", "binding": "ASSETS", "run_worker_first": true},
  "observability": {"enabled": true, "head_sampling_rate": 0.1},
  "vars": {
    "APP_ORIGIN": "https://scheduler.invalid",
    "SUPABASE_URL": "https://replace-with-new-project.supabase.co",
    "OWNER_ID": "replace-with-dedicated-owner-uuid",
    "REMOTE_CONTROL_ENABLED": "false"
  },
  "d1_databases": [{
    "binding": "SCHEDULER_REMOTE",
    "database_name": "scheduler-dashboard",
    "database_id": "00000000-0000-0000-0000-000000000000"
  }]
}
